	<profiles>
		<profile>
			<id>unify-jackson3-jars</id>
			<activation>
				<property>
					<name>scijava.app.directory</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<!-- The SciJava maven plugin will overwrite jackson 2 jars with jackson 3 -->
						<!-- We want the final state of the app.directory to contain the both -->
						<!-- see https://github.com/scijava/scijava-maven-plugin/issues/37 -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-dependencies</id>
								<phase>install</phase>
								<goals>
									<goal>copy-dependencies</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/dependency</outputDirectory>
									<stripVersion>false</stripVersion>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>rename-jackson3-jars</id>
								<phase>install</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- Rename Jackson 3 jars -->
										<move file="${scijava.app.directory}/jars/jackson-databind-${jackson3.version}.jar" tofile="${scijava.app.directory}/jars/jackson3-databind-${jackson3.version}.jar" failonerror="false" />
										<move file="${scijava.app.directory}/jars/jackson-core-${jackson3.version}.jar" tofile="${scijava.app.directory}/jars/jackson3-core-${jackson3.version}.jar" failonerror="false" />
										<move file="${scijava.app.directory}/jars/jackson-dataformat-yaml-${jackson3.version}.jar" tofile="${scijava.app.directory}/jars/jackson3-dataformat-yaml-${jackson3.version}.jar" failonerror="false" />

										<!-- Restore Jackson 2 jars from target/dependency -->
